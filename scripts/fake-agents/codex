#!/usr/bin/env bash
# Fake `codex` CLI to test AI-agent detection by process name.
# Usage:  PATH="$PWD/scripts/fake-agents:$PATH" codex
echo "◐ fake codex session starting"
sleep 1
frames=(◐ ◓ ◑ ◒)
i=0
SECONDS=0
while [ "$SECONDS" -lt 20 ]; do
  printf '\r  %s Executing… (%ss)        ' "${frames[i%4]}" "$SECONDS"
  i=$((i + 1))
  sleep 0.2
done
printf '\r%-60s\n' " "
echo "✔ done — badge should now read 'done · codex'"
